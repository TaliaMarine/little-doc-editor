HTTP_ADDR=:8080
LOG_LEVEL=info
DATABASE_URL=postgres://postgres:postgres@localhost:5432/little_doc_editor?sslmode=disable
REDIS_ADDR=localhost:6379

# NEVER set this to true outside your own machine — see internal/authctx.
# Skips authentication entirely and treats every request as an org-admin.
# When this is true, none of the auth settings below are needed.
DEV_AUTH_BYPASS=true

# --- Real auth (needed when DEV_AUTH_BYPASS=false) ---
# Must match collab's SESSION_JWT_SECRET exactly — both validate the same
# session tokens (SPEC.md §4).
SESSION_JWT_SECRET=shared-dev-secret-change-me
SESSION_TTL=24h
# Creates the first internal org-admin account on startup if none exists
# yet (Decision 11) — a no-op after that, safe to leave set.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=correct-horse-battery-staple
# Re-enables internal login even if an admin disabled it via
# PATCH /admin/settings (Decision 14) — an escape hatch for a
# misconfigured OIDC setup, never a default-on setting.
# INTERNAL_LOGIN_BREAK_GLASS=true

# --- OIDC (optional; Decision 14) ---
# OIDC_ENABLED=true
# OIDC_ISSUER=https://idp.example.com
# OIDC_CLIENT_ID=little-doc-editor
# OIDC_CLIENT_SECRET=changeme
# OIDC_REDIRECT_URL=http://localhost:8080/api/v1/auth/oidc/callback

# S3-compatible object storage — these defaults match docker-compose.yml's
# MinIO service and the bucket minio-init creates automatically.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=little-doc-editor-attachments
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_USE_PATH_STYLE=true

# Optional overrides — see internal/config for defaults (image/PDF/Office/
# zip/text allowlist, 25MB max).
# ATTACHMENT_ALLOWLIST=image/png,image/jpeg,application/pdf
# ATTACHMENT_MAX_SIZE_BYTES=26214400

# --- Hardening / ops (all optional) ---
# Requests from these proxies may set X-Forwarded-For (CIDRs or IPs). Leave
# empty when the api is directly exposed.
# TRUSTED_PROXIES=10.0.0.0/8
# Rate limiting uses REDIS_ADDR (falls back to per-process counters).
# REDIS_USERNAME=
# REDIS_PASSWORD=
# REDIS_TLS=false
# Alternative to REDIS_ADDR (wins over it): redis://[user:pass@]host[:port][/db], rediss:// = TLS.
# REDIS_URL=

# Opt-in CORS for an SPA served from another origin: exact origins, comma-separated,
# never "*". Empty = same-origin only. No cookies/credentials are ever allowed.
# CORS_ALLOWED_ORIGINS=https://docs.example.com
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_LOGIN_PER_MINUTE=10
# RATE_LIMIT_PUBLIC_PER_MINUTE=30
# History cleanup: 5-field cron, "@daily", "@every 6h", or "off".
# HISTORY_CLEANUP_SCHEDULE=0 3 * * *
# HISTORY_REVISION_DEBOUNCE=5m
# Prometheus /metrics on a separate listener (off when unset).
# METRICS_ADDR=:9090
# OTLP tracing (http/protobuf or grpc).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

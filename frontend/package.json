    "vue-i18n": "^11.3.0",
    "vue-router": "^5.0.3",
    "vuetify": "4.1.12"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.5",
    "@types/node": "^24.12.0",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/tsconfig": "^0.9.0",
    "eslint": "^9.39.4",

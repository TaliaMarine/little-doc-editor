PORT=1234
DATABASE_URL=postgres://postgres:postgres@localhost:5432/little_doc_editor?sslmode=disable
# REDIS_ADDR (host, host:port, [v6]:port) or REDIS_URL (redis[s]://user:pass@host:port/db)
REDIS_ADDR=localhost:6379
# REDIS_USERNAME=
# REDIS_TLS=true
# Must match the signing secret the api service uses for session/guest tokens,
# so a WS client's token can be validated without calling back into api on
# every connect (SPEC.md §4: "shared secret or JWKS check").
SESSION_JWT_SECRET=change-me-in-every-environment
# Optional Redis AUTH password; leave unset for the local docker-compose Redis.
# REDIS_PASSWORD=
# Optional: serve /metrics on this separate port only (unset = on PORT behind the forwarding-header check)
# METRICS_PORT=9464
# Same rule as api's HISTORY_REVISION_DEBOUNCE
# HISTORY_REVISION_DEBOUNCE=5m

# Browser origins allowed to open the WebSocket (comma-separated; other origins get 403).
# Unset = no origin check. A missing Origin header (non-browser client) is left to token auth.
# COLLAB_ALLOWED_ORIGINS=https://docs.example.com

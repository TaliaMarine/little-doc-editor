PORT=1234
DATABASE_URL=postgres://postgres:postgres@localhost:5432/little_doc_editor?sslmode=disable
REDIS_ADDR=localhost:6379
# Must match the signing secret the api service uses for session/guest tokens,
# so a WS client's token can be validated without calling back into api on
# every connect (SPEC.md §4: "shared secret or JWKS check").
SESSION_JWT_SECRET=change-me-in-every-environment
# Optional Redis AUTH password; leave unset for the local docker-compose Redis.
# REDIS_PASSWORD=
